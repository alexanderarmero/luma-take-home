# Copy to .env.local for local development, or set these on your host.
# Never commit a filled-in copy — .env and .env.local are gitignored.

# ---- Slack (ticket 01) ----------------------------------------------------
# App credentials: api.slack.com/apps -> your app -> Basic Information
SLACK_SIGNING_SECRET=
# Bot token: OAuth & Permissions -> Bot User OAuth Token (starts xoxb-)
SLACK_BOT_TOKEN=
# The dedicated review channel's ID (right-click channel -> View channel details)
SLACK_REVIEW_CHANNEL_ID=
# The only Slack user allowed to approve or discard in v1 (Ellie).
SLACK_APPROVER_USER_ID=

# ---- Image generation (ticket 05) -----------------------------------------
LUMA_AGENTS_API_KEY=

# ---- Prompt translation (ticket 06) ---------------------------------------
ANTHROPIC_API_KEY=

# ---- Storage: Cloudflare R2 (ticket 05) -----------------------------------
# R2 speaks the S3 API, so any S3-compatible host works. Leave S3_ENDPOINT
# unset to use AWS S3 instead.
#
# Where to find these in Cloudflare:
#   R2 -> Overview -> Create bucket            -> S3_BUCKET
#   R2 -> Overview -> the bucket -> Settings   -> the S3 API endpoint
#   R2 -> Manage API tokens -> Create token
#        (Object Read & Write, scoped to this bucket)
#        -> Access Key ID / Secret Access Key
S3_BUCKET=styled-shots
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 ignores the region; "auto" is Cloudflare's own documented value.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Database (ticket 03) -------------------------------------------------
DATABASE_URL=

# ---- Host ------------------------------------------------------------------
# Set automatically by most platforms; defaults to 3000.
PORT=
