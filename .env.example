# Copy to .env.local for local development, or set these on your host.
# Never commit a filled-in copy — .env and .env.local are gitignored.

# ---- Slack (ticket 01) ----------------------------------------------------
# App credentials: api.slack.com/apps -> your app -> Basic Information
SLACK_SIGNING_SECRET=
# Bot token: OAuth & Permissions -> Bot User OAuth Token (starts xoxb-)
SLACK_BOT_TOKEN=
# The dedicated review channel's ID (right-click channel -> View channel details)
SLACK_REVIEW_CHANNEL_ID=
# The only Slack user allowed to approve or discard in v1 (Ellie).
SLACK_APPROVER_USER_ID=

# ---- Image generation (ticket 05) -----------------------------------------
LUMA_AGENTS_API_KEY=

# ---- Prompt translation (ticket 06) ---------------------------------------
# Optional. Without it, shot ideas go to the image model unchanged — which
# works, but all candidates for a product come from one prompt, so they are
# variations rather than genuinely different readings.
ANTHROPIC_API_KEY=

# ---- Storage: Railway Bucket (ticket 05) ----------------------------------
# Create a Bucket in the same Railway project (Create -> Bucket), then wire
# these with Variable References so they follow any credential rotation:
#
#   S3_BUCKET            = ${{Bucket.BUCKET}}
#   S3_ENDPOINT          = ${{Bucket.ENDPOINT}}
#   S3_REGION            = ${{Bucket.REGION}}
#   S3_ACCESS_KEY_ID     = ${{Bucket.ACCESS_KEY_ID}}
#   S3_SECRET_ACCESS_KEY = ${{Bucket.SECRET_ACCESS_KEY}}
#
# (Replace "Bucket" with your bucket's service name if you renamed it.)
#
# Note BUCKET, not RAILWAY_BUCKET_NAME — the S3 API needs the globally unique
# name, which is your display name plus a short hash.
S3_BUCKET=
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Leave unset. Virtual-hosted addressing is the S3 standard and what Railway
# uses. Set to "true" only if your bucket's Credentials tab says path-style —
# some buckets created before Railway's switch still need it.
S3_FORCE_PATH_STYLE=

# Any other S3-compatible host works unchanged. For Cloudflare R2:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3, leave S3_ENDPOINT unset and set a real S3_REGION.

# ---- Database (ticket 03) -------------------------------------------------
DATABASE_URL=

# ---- Public URL ------------------------------------------------------------
# The deployed service's own URL. Slack fetches review images from it, so it
# has to be reachable from the internet — the domain Railway generated under
# Settings -> Networking. No trailing slash needed; one is trimmed anyway.
PUBLIC_BASE_URL=https://your-service.up.railway.app

# ---- Host ------------------------------------------------------------------
# Set automatically by most platforms; defaults to 3000.
PORT=
